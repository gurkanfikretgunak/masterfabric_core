{
  "appSettings": {
    "appName": "MasterFabric",
    "version": "0.0.1",
    "environment": "development",
    "debugMode": true,
    "maintenanceMode": false,
    "minSupportedVersion": "0.0.1"
  },
  "uiConfiguration": {
    "themeMode": "light",
    "fontScale": 1.0,
    "textDirection": "ltr",
    "showPerformanceOverlay": false,
    "devModeGrid": true,
    "devModeSpacer": true
  },
  "splashConfiguration": {
    "style": "startup",
    "autoNavigate": true,
    "durationSeconds": 3,
    "logoUrl": "",
    "logoWidth": 112.0,
    "logoHeight": 112.0,
    "showLoadingIndicator": true,
    "loadingIndicatorSize": 32,
    "loadingText": "Loading...",
    "showAppVersion": false,
    "showCopyright": false,
    "copyrightText": "© 2025 OSMEA Team",
    "devModeTapCount": 5,
    "devModeEnabled": false,
    "animationDuration": 300,
    "primaryColor": "#2196F3",
    "textColor": "#000000",
    "backgroundColor": "#FFFFFF",
    "appName": "MasterFabric",
    "appVersion": "0.0.1"
  },
  "featureFlags": {
    "onboardingEnabled": true,
    "analyticsEnabled": false,
    "crashReportingEnabled": false,
    "remoteConfigEnabled": false
  },
  "navigationConfiguration": {
    "defaultRoute": "/",
    "enableDeepLinking": true,
    "enableBackButton": true
  },
  "apiConfiguration": {
    "baseUrl": "",
    "timeoutSeconds": 30,
    "retryCount": 3,
    "enableLogging": true
  },
  "permissionsConfiguration": {
    "requestOnStartup": false,
    "requiredPermissions": [],
    "optionalPermissions": [],
    "showSummaryFirst": true,
    "summaryTitle": "Permissions needed",
    "summaryDescription": "This app needs access to the following:",
    "summaryContinueLabel": "Continue",
    "permissionDescriptions": {
      "camera": "To capture photos and videos",
      "location": "To show nearby places",
      "locationWhenInUse": "To show relevant content based on your location",
      "photos": "To let you choose images from your library",
      "microphone": "For voice features",
      "contacts": "To help you connect with others",
      "notification": "To send you important updates"
    },
    "bottomSheetStyle": {
      "primaryColor": "#2196F3",
      "backgroundColor": "#FFFFFF",
      "textColor": "#000000",
      "borderRadius": 24,
      "grantButtonLabel": "Allow",
      "skipButtonLabel": "Skip",
      "notNowButtonLabel": "Not Now"
    }
  },
  "localizationConfiguration": {
    "defaultLocale": "en",
    "supportedLocales": ["en"],
    "fallbackLocale": "en"
  },
  "storageConfiguration": {
    "localStorageType": "sharedPreferences",
    "enableEncryption": false,
    "cacheDurationDays": 7,
    "maxCacheSizeMb": 100
  },
  "pushNotificationConfiguration": {
    "enabled": true,
    "defaultProvider": "onesignal",
    "autoInitialize": true,
    "providers": {
      "onesignal": {
        "enabled": true,
        "appId": "YOUR_ONESIGNAL_APP_ID"
      },
      "firebase": {
        "enabled": false,
        "vapidKey": ""
      }
    }
  }
}
